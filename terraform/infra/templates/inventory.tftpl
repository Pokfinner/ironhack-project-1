# Generated by Terraform - do not edit by hand

[frontend]
frontend-instance-1 ansible_host=${frontend_private_ip}

[backend]
backend-instance-1 ansible_host=${backend_private_ip}

[db]
db-instance-1 ansible_host=${db_private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/voting-app-key
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ~/.ssh/voting-app-key -o StrictHostKeyChecking=accept-new -W %h:%p -q ubuntu@${bastion_public_ip}"'

